<odoo>
    <record id="view_hr_employee_form_inherit_iqama" model="ir.ui.view">
        <field name="name">view.hr.employee.form.inherit.iqama</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">

            <!-- ── Stat button: Residency/Iqama count ── -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_iqamas" type="object" class="oe_stat_button" icon="fa-id-card-o" groups="hr.group_hr_user,base.group_system">
                    <field name="iqama_count" string="Residencies" widget="statinfo"/>
                </button>
            </xpath>

            <!-- ── Hide original work-contact fields (we re-show them in our tab) ── -->
            <xpath expr="//field[@name='work_email']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='work_phone']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='mobile_phone']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='category_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='company_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='employee_type']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='department_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='job_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='parent_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='coach_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- ── Move formerly duplicated Details fields into Work Information ── -->
            <xpath expr="//page[@name='public']//div[@id='o_work_employee_main']/group[1]" position="before">
                <group name="nx_work_details" string="Work Details">
                    <group string="Work Contact">
                        <field name="work_email" widget="email"/>
                        <field name="work_phone" widget="phone"/>
                        <field name="mobile_phone" widget="phone"/>
                        <field name="category_ids"
                               widget="many2many_tags"
                               options="{'color_field': 'color', 'no_create_edit': True}"
                               string="Tags"
                               groups="hr.group_hr_user"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="employee_type"/>
                    </group>
                    <group string="Organization">
                        <field name="department_id" readonly="1" force_save="1"/>
                        <field name="job_id"/>
                        <field name="parent_id" string="Manager" widget="many2one_avatar_user"/>
                        <field name="coach_id" widget="many2one_avatar_user"/>
                    </group>
                </group>
            </xpath>

            <!-- ── Private Information: custom grid layout ── -->
            <xpath expr="//page[@name='personal_information']//group[@name='emergency']" position="before">
                <div class="nx_hr_private_info_layout">
                    <div class="nx_hr_private_info_row nx_hr_private_info_row_top">
                        <group string="Passport Info">
                            <field name="ssnid"/>
                            <field name="passport_id"/>
                            <field name="passport_name_english"/>
                            <field name="passport_name_arabic"/>
                        </group>
                        <group string="Emergency">
                            <field name="emergency_contact"/>
                            <field name="emergency_phone" class="o_force_ltr"/>
                        </group>
                    </div>
                    <div class="nx_hr_private_info_row nx_hr_private_info_row_bottom">
                        <group string="Family Status">
                            <field name="marital"/>
                            <field name="spouse_complete_name" invisible="marital not in ['married', 'cohabitant']"/>
                            <field name="spouse_birthdate" invisible="marital not in ['married', 'cohabitant']"/>
                            <field name="children"/>
                        </group>
                        <group string="Work Permit">
                            <field name="visa_no"/>
                            <field name="permit_no"/>
                            <field name="visa_expire"/>
                            <field name="work_permit_expiration_date"/>
                            <field name="work_permit_name" invisible="1"/>
                            <field name="has_work_permit" widget="work_permit_upload" filename="work_permit_name"/>
                        </group>
                    </div>
                </div>
            </xpath>

            <!-- ── Hide duplicated fields already shown in our custom layout ── -->
            <xpath expr="//page[@name='personal_information']//field[@name='ssnid']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='personal_information']//field[@name='passport_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- ── Add Residency Approvers into Work Info Approvers group ── -->
            <xpath expr="//group[@name='managers']" position="inside">
                <field name="residency_approver_ids"
                       widget="many2many_avatar_user"
                       string="Residency"
                       groups="hr.group_hr_user,base.group_system"/>
            </xpath>

            <!-- ── Remove original emergency and work-permit groups ── -->
            <xpath expr="//page[@name='personal_information']//group[@name='emergency']" position="replace"/>
            <xpath expr="//page[@name='personal_information']//separator[@name='has_work_permit']/ancestor::group[1]" position="replace"/>

            <!-- ── Group Work Information into 3 side-by-side collapsible sections ──
                 Build a 3-column grid of collapsible tiles, then move the three
                 existing groups (nx_work_details from this module,
                 nx_location_schedule_row / nx_approvers_allowance_row from
                 nx_hr_policy_management) into their tiles. -->
            <xpath expr="//page[@name='public']//div[@id='o_work_employee_main']" position="inside">
                <div class="nx_wi_section_grid">

                    <div class="nx_wi_section_item">
                        <widget name="section_toggle" data-default-open="false"/>
                        <div class="closed-section nx_wi_slot_contact" style="display:none;">
                            <div class="nx_section_meta"
                                 data-title="Contact &amp; Organization"
                                 data-icon="fa-address-card-o"
                                 data-color="#0EA5E9"
                                 style="display:none;"/>
                        </div>
                    </div>

                    <div class="nx_wi_section_item">
                        <widget name="section_toggle" data-default-open="false"/>
                        <div class="closed-section nx_wi_slot_location" style="display:none;">
                            <div class="nx_section_meta"
                                 data-title="Location &amp; Schedule"
                                 data-icon="fa-map-marker"
                                 data-color="#22C55E"
                                 style="display:none;"/>
                        </div>
                    </div>

                    <div class="nx_wi_section_item">
                        <widget name="section_toggle" data-default-open="false"/>
                        <div class="closed-section nx_wi_slot_approvers" style="display:none;">
                            <div class="nx_section_meta"
                                 data-title="Approvers &amp; Leave Allowance"
                                 data-icon="fa-check-circle-o"
                                 data-color="#8B5CF6"
                                 style="display:none;"/>
                        </div>
                    </div>

                </div>
            </xpath>

            <xpath expr="//div[hasclass('nx_wi_slot_contact')]" position="inside">
                <xpath expr="//group[@name='nx_work_details']" position="move"/>
            </xpath>
            <xpath expr="//div[hasclass('nx_wi_slot_location')]" position="inside">
                <xpath expr="//group[@name='nx_location_schedule_row']" position="move"/>
            </xpath>
            <xpath expr="//div[hasclass('nx_wi_slot_approvers')]" position="inside">
                <xpath expr="//group[@name='nx_approvers_allowance_row']" position="move"/>
            </xpath>

            <!-- ── Group Private Information into 3 side-by-side collapsible sections ──
                 Build the grid, move the six existing groups into three tiles
                 (two groups each), then drop the now-empty original wrappers. -->
            <xpath expr="//page[@name='personal_information']" position="inside">
                <div class="nx_pi_section_grid">

                    <div class="nx_pi_section_item">
                        <widget name="section_toggle" data-default-open="false"/>
                        <div class="closed-section nx_pi_slot_contact" style="display:none;">
                            <div class="nx_section_meta"
                                 data-title="Contact &amp; Citizenship"
                                 data-icon="fa-address-book-o"
                                 data-color="#0EA5E9"
                                 style="display:none;"/>
                            <group name="nx_pi_pair_contact"/>
                        </div>
                    </div>

                    <div class="nx_pi_section_item">
                        <widget name="section_toggle" data-default-open="false"/>
                        <div class="closed-section nx_pi_slot_docs" style="display:none;">
                            <div class="nx_section_meta"
                                 data-title="Passport &amp; Work Permit"
                                 data-icon="fa-id-card-o"
                                 data-color="#22C55E"
                                 style="display:none;"/>
                            <group name="nx_pi_pair_docs"/>
                        </div>
                    </div>

                    <div class="nx_pi_section_item">
                        <widget name="section_toggle" data-default-open="false"/>
                        <div class="closed-section nx_pi_slot_family" style="display:none;">
                            <div class="nx_section_meta"
                                 data-title="Family &amp; Emergency"
                                 data-icon="fa-users"
                                 data-color="#8B5CF6"
                                 style="display:none;"/>
                            <group name="nx_pi_pair_family"/>
                        </div>
                    </div>

                </div>
            </xpath>

            <!-- Tile 1: Private Contact + Citizenship (side by side) -->
            <xpath expr="//group[@name='nx_pi_pair_contact']" position="inside">
                <xpath expr="//page[@name='personal_information']//field[@name='private_street']/ancestor::group[1]" position="move"/>
                <xpath expr="//page[@name='personal_information']//field[@name='identification_id']/ancestor::group[1]" position="move"/>
            </xpath>

            <!-- Tile 2: Passport Info + Work Permit (side by side) -->
            <xpath expr="//group[@name='nx_pi_pair_docs']" position="inside">
                <xpath expr="//page[@name='personal_information']//field[@name='passport_name_english']/ancestor::group[1]" position="move"/>
                <xpath expr="//page[@name='personal_information']//field[@name='has_work_permit']/ancestor::group[1]" position="move"/>
            </xpath>

            <!-- Tile 3: Family Status + Emergency (side by side) -->
            <xpath expr="//group[@name='nx_pi_pair_family']" position="inside">
                <xpath expr="//page[@name='personal_information']//field[@name='spouse_complete_name']/ancestor::group[1]" position="move"/>
                <xpath expr="//page[@name='personal_information']//field[@name='emergency_contact']/ancestor::group[1]" position="move"/>
            </xpath>

            <!-- Drop the now-empty original wrappers (outer group + custom layout div). -->
            <xpath expr="//page[@name='personal_information']//div[hasclass('nx_hr_private_info_layout')]" position="replace"/>
            <xpath expr="//page[@name='personal_information']/group[1]" position="replace"/>

        </field>
    </record>
</odoo>
