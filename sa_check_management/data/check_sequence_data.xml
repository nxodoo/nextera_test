<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_check_incoming" model="ir.sequence">
        <field name="name">Incoming Checks</field>
        <field name="code">sa.check.incoming</field>
        <field name="prefix">CHK/IN/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_check_outgoing" model="ir.sequence">
        <field name="name">Outgoing Checks</field>
        <field name="code">sa.check.outgoing</field>
        <field name="prefix">CHK/OUT/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
