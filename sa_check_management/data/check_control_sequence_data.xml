<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_check_handover" model="ir.sequence">
        <field name="name">Check Handovers</field>
        <field name="code">sa.check.handover</field>
        <field name="prefix">HND/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_check_book" model="ir.sequence">
        <field name="name">Checkbooks</field>
        <field name="code">sa.check.book</field>
        <field name="prefix">CB/%(year)s/</field>
        <field name="padding">3</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
