<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="check_action_request_view_form" model="ir.ui.view">
        <field name="name">check.action.request.view.form</field>
        <field name="model">check.action.request</field>
        <field name="arch" type="xml">
            <form string="Approval Request" create="0">
                <header>
                    <button name="action_approve" type="object" string="Approve and Run" class="btn-primary"
                            invisible="state != 'pending'"/>
                    <button name="action_reject" type="object" string="Reject" invisible="state != 'pending'"/>
                    <button name="action_cancel" type="object" string="Withdraw Request" invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,approved"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="check_id"/>
                            <field name="partner_id"/>
                            <field name="amount"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="check_state"/>
                        </group>
                        <group>
                            <field name="action"/>
                            <field name="requested_by_id"/>
                            <field name="approver_group_id"/>
                            <field name="action_date" invisible="not action_date"/>
                            <field name="recipient" invisible="not recipient"/>
                            <field name="decided_by_id" invisible="state == 'pending'"/>
                            <field name="decision_date" invisible="state == 'pending'"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason"/>
                        <field name="decision_note" readonly="state != 'pending'" placeholder="Required to reject"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="check_action_request_view_list" model="ir.ui.view">
        <field name="name">check.action.request.view.list</field>
        <field name="model">check.action.request</field>
        <field name="arch" type="xml">
            <list string="Approval Requests" create="0" decoration-info="state == 'pending'" decoration-muted="state in ('cancelled', 'rejected')">
                <field name="currency_id" column_invisible="True"/>
                <field name="name"/>
                <field name="create_date" string="Requested On"/>
                <field name="check_id"/>
                <field name="partner_id"/>
                <field name="amount"/>
                <field name="action"/>
                <field name="requested_by_id" widget="many2one_avatar_user"/>
                <field name="approver_group_id" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-warning="state == 'pending'"/>
            </list>
        </field>
    </record>

    <record id="check_action_request_view_search" model="ir.ui.view">
        <field name="name">check.action.request.view.search</field>
        <field name="model">check.action.request</field>
        <field name="arch" type="xml">
            <search string="Approval Requests">
                <field name="check_id"/>
                <field name="partner_id"/>
                <field name="requested_by_id"/>
                <filter name="filter_pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="filter_to_me" string="Waiting for Me"
                        domain="[('state', '=', 'pending'), ('approver_group_id.users', 'in', uid), ('requested_by_id', '!=', uid)]"/>
                <filter name="filter_mine" string="My Requests" domain="[('requested_by_id', '=', uid)]"/>
                <group string="Group By">
                    <filter name="group_action" string="Action" context="{'group_by': 'action'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_check_action_request" model="ir.actions.act_window">
        <field name="name">Approval Requests</field>
        <field name="res_model">check.action.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="check_action_request_view_search"/>
        <field name="context">{'search_default_filter_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No approval requests.</p>
            <p>Sensitive check actions that need a second person's approval wait here.</p>
        </field>
    </record>

    <record id="check_action_rule_view_list" model="ir.ui.view">
        <field name="name">check.action.rule.view.list</field>
        <field name="model">check.action.rule</field>
        <field name="arch" type="xml">
            <list string="Sensitive Action Rules" editable="bottom">
                <field name="action"/>
                <field name="approver_group_id" options="{'no_create': True}"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_check_action_rule" model="ir.actions.act_window">
        <field name="name">Sensitive Action Rules</field>
        <field name="res_model">check.action.rule</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No action needs a second approval.</p>
            <p>Add an action here so it is sent for approval instead of running directly; the requester can never approve it.</p>
        </field>
    </record>

    <record id="check_partner_statement_wizard_view_form" model="ir.ui.view">
        <field name="name">check.partner.statement.wizard.view.form</field>
        <field name="model">check.partner.statement.wizard</field>
        <field name="arch" type="xml">
            <form string="Check Statement">
                <group>
                    <group>
                        <field name="partner_id"/>
                        <field name="check_type" widget="radio"/>
                    </group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print" type="object" string="Print" class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" special="cancel" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_partner_form_inherit_sa_check" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.sa.check</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_partner_checks" type="object" class="oe_stat_button" icon="fa-money"
                        groups="sa_check_management.group_check_user">
                    <field name="sa_check_count" widget="statinfo" string="Checks"/>
                </button>
                <button name="action_open_check_statement" type="object" class="oe_stat_button" icon="fa-file-text-o"
                        string="Check Statement" groups="sa_check_management.group_check_user"/>
            </xpath>
        </field>
    </record>
</odoo>
