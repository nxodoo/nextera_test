<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_inherit_sa_check" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.sa.check</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group1']/field[@name='memo']" position="after">
                <field name="sa_check_id" invisible="not sa_check_id"/>
            </xpath>
        </field>
    </record>
</odoo>
