<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="check_check_view_form" model="ir.ui.view">
        <field name="name">check.check.view.form</field>
        <field name="model">check.check</field>
        <field name="arch" type="xml">
            <form string="Check" duplicate="0">
                <header>
                    <button name="action_receive" type="object" string="Receive" class="btn-primary"
                            invisible="check_type != 'incoming' or state != 'draft'"
                            groups="sa_check_management.group_check_user"/>
                    <button name="action_submit" type="object" string="Submit for Approval" class="btn-primary"
                            invisible="check_type != 'outgoing' or state != 'draft' or not approval_required"
                            groups="sa_check_management.group_check_user"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="state != 'pending_approval'"
                            groups="sa_check_management.group_check_approver"/>
                    <button name="action_open_reject_wizard" type="object" string="Reject"
                            invisible="state != 'pending_approval'"
                            groups="sa_check_management.group_check_approver"/>
                    <button name="action_issue" type="object" string="Issue" class="btn-primary"
                            invisible="check_type != 'outgoing' or not (state == 'approved' or (state == 'draft' and not approval_required))"
                            groups="sa_check_management.group_check_user"/>
                    <button name="action_open_deliver_wizard" type="object" string="Deliver" class="btn-primary"
                            invisible="state != 'issued'"
                            groups="sa_check_management.group_check_user"/>
                    <button name="action_open_deposit_wizard" type="object" string="Deposit" class="btn-primary"
                            invisible="check_type != 'incoming' or state != 'received' or purpose in ('guarantee', 'security')"
                            groups="sa_check_management.group_check_treasury"/>
                    <button name="action_open_deposit_wizard" type="object" string="Re-deposit" class="btn-primary"
                            invisible="check_type != 'incoming' or state != 'bounced'"
                            groups="sa_check_management.group_check_treasury"/>
                    <button name="action_open_discount_wizard" type="object" string="Discount at Bank"
                            invisible="not discount_enabled or check_type != 'incoming' or state != 'received' or purpose in ('guarantee', 'security') or accounting_status != 'posted'"
                            groups="sa_check_management.group_check_treasury"/>
                    <button name="action_open_collection_wizard" type="object" string="Collect" class="btn-primary"
                            invisible="state not in ('under_collection', 'discounted')"
                            groups="sa_check_management.group_check_treasury"/>
                    <button name="action_open_bounce_wizard" type="object" string="Bounce"
                            invisible="state not in ('under_collection', 'discounted')"
                            groups="sa_check_management.group_check_treasury"/>
                    <button name="action_open_withdraw_wizard" type="object" string="Withdraw from Bank"
                            invisible="state != 'under_collection'"
                            groups="sa_check_management.group_check_manager"/>
                    <button name="action_open_collection_wizard" type="object" string="Mark Cleared"
                            invisible="check_type != 'outgoing' or state not in ('issued', 'delivered', 'presented')"
                            groups="sa_check_management.group_check_treasury"/>
                    <button name="action_open_endorsement_wizard" type="object" string="Endorse"
                            invisible="check_type != 'incoming' or state != 'received' or purpose in ('guarantee', 'security')"
                            groups="sa_check_management.group_check_treasury"/>
                    <button name="action_open_endorse_bounce_wizard" type="object" string="Endorsed Check Bounced"
                            invisible="state != 'endorsed'" groups="sa_check_management.group_check_treasury"/>
                    <button name="action_open_unendorse_wizard" type="object" string="Returned by Endorsee"
                            invisible="state != 'endorsed'" groups="sa_check_management.group_check_manager"/>
                    <button name="action_open_release_wizard" type="object" string="Release Guarantee"
                            invisible="purpose not in ('guarantee', 'security') or not ((check_type == 'incoming' and state == 'received') or (check_type == 'outgoing' and state in ('issued', 'delivered')))"
                            groups="sa_check_management.group_check_manager"/>
                    <button name="action_open_invoke_wizard" type="object" string="Invoke Guarantee"
                            invisible="purpose not in ('guarantee', 'security') or not ((check_type == 'incoming' and state == 'received') or (check_type == 'outgoing' and state == 'delivered'))"
                            groups="sa_check_management.group_check_manager"/>
                    <button name="action_open_replacement_wizard" type="object" string="Replace"
                            invisible="not ((check_type == 'incoming' and state in ('received', 'bounced', 'legal')) or (check_type == 'outgoing' and state == 'rejected'))"
                            groups="sa_check_management.group_check_treasury"/>
                    <button name="action_open_settle_wizard" type="object" string="Settled Otherwise"
                            invisible="not ((check_type == 'incoming' and state in ('bounced', 'legal')) or (check_type == 'outgoing' and state == 'rejected'))"
                            groups="sa_check_management.group_check_treasury"/>
                    <button name="action_open_legal_wizard" type="object" string="Legal Action"
                            invisible="check_type != 'incoming' or state != 'bounced'"
                            groups="sa_check_management.group_check_treasury"/>
                    <button name="action_open_lost_wizard" type="object" string="Lost"
                            invisible="not ((check_type == 'incoming' and state == 'received') or (check_type == 'outgoing' and state in ('issued', 'delivered')))"
                            groups="sa_check_management.group_check_manager"/>
                    <button name="action_open_stop_wizard" type="object" string="Stop Payment"
                            invisible="check_type != 'outgoing' or state not in ('issued', 'delivered', 'presented')"
                            groups="sa_check_management.group_check_treasury"/>
                    <button name="action_open_bank_reject_wizard" type="object" string="Rejected by Bank"
                            invisible="check_type != 'outgoing' or state not in ('issued', 'delivered', 'presented')"
                            groups="sa_check_management.group_check_treasury"/>
                    <button name="action_open_void_stale_wizard" type="object" string="Void Stale Check"
                            invisible="not is_stale" groups="sa_check_management.group_check_manager"/>
                    <button name="action_mark_presented" type="object" string="Mark Presented"
                            invisible="check_type != 'outgoing' or state != 'delivered'"
                            groups="sa_check_management.group_check_treasury"/>
                    <button name="action_open_reallocation_wizard" type="object" string="Repair Allocations"
                            invisible="not accounting_attention"
                            groups="sa_check_management.group_check_manager,sa_check_management.group_check_accountant"/>
                    <button name="action_mark_accounting_reviewed" type="object" string="Mark Accounting Reviewed"
                            invisible="not accounting_attention"
                            groups="sa_check_management.group_check_manager,sa_check_management.group_check_accountant"/>
                    <button name="action_open_return_wizard" type="object" string="Return to Partner"
                            invisible="check_type != 'incoming' or state not in ('received', 'bounced', 'legal') or purpose in ('guarantee', 'security')"
                            groups="sa_check_management.group_check_user"/>
                    <button name="action_open_reset_wizard" type="object" string="Reset to Draft"
                            invisible="state not in ('received', 'approved')"
                            groups="sa_check_management.group_check_treasury"/>
                    <button name="action_open_cancel_wizard" type="object" string="Cancel"
                            invisible="not (state == 'draft' or (check_type == 'incoming' and state == 'received') or (check_type == 'outgoing' and state in ('pending_approval', 'approved', 'issued')))"
                            groups="sa_check_management.group_check_user"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,received,under_collection,collected"
                           invisible="check_type != 'incoming'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,approved,issued,delivered,cleared"
                           invisible="check_type != 'outgoing'"/>
                </header>
                <div class="alert alert-warning mb-0" role="alert" invisible="not pending_request_count">
                    <i class="fa fa-hourglass-half me-1"/> An action on this check is waiting for approval.
                </div>
                <field name="pending_request_count" invisible="1"/>
                <div class="alert alert-danger mb-0" role="alert" invisible="not accounting_attention">
                    <strong>Needs accounting review: </strong>
                    <field name="accounting_attention_note" class="d-inline"/>
                </div>
                <field name="accounting_attention" invisible="1"/>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_requests" type="object" class="oe_stat_button"
                                icon="fa-check-square-o" invisible="not action_request_ids">
                            <field name="pending_request_count" widget="statinfo" string="Pending Approvals"/>
                        </button>
                        <field name="action_request_ids" invisible="1"/>
                        <button name="action_view_entries" type="object" class="oe_stat_button"
                                icon="fa-book" invisible="not entry_count"
                                groups="account.group_account_invoice">
                            <field name="entry_count" widget="statinfo" string="Entries"/>
                        </button>
                        <button name="action_view_payments" type="object" class="oe_stat_button"
                                icon="fa-money" invisible="not payment_count"
                                groups="account.group_account_invoice">
                            <field name="payment_count" widget="statinfo" string="Payments"/>
                        </button>
                        <button name="action_view_events" type="object"
                                class="oe_stat_button" icon="fa-history">
                            <field name="event_count" widget="statinfo" string="Events"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <widget name="web_ribbon" title="Stale" bg_color="text-bg-warning"
                            invisible="not is_stale or not active"/>
                    <field name="active" invisible="1"/>
                    <field name="company_currency_id" invisible="1"/>
                    <field name="company_partner_id" invisible="1"/>
                    <field name="approval_required" invisible="1"/>
                    <field name="commercial_partner_id" invisible="1"/>
                    <field name="allocation_account_type" invisible="1"/>
                    <field name="is_stale" invisible="1"/>
                    <field name="discount_enabled" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Check Information" name="check_information">
                            <field name="check_type"/>
                            <field name="purpose" readonly="state != 'draft'"/>
                            <field name="check_number" readonly="state != 'draft' or leaf_id" force_save="1"/>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="reference"/>
                            <field name="guarantee_description" invisible="purpose not in ('guarantee', 'security')"/>
                            <field name="guarantee_reference" invisible="purpose not in ('guarantee', 'security')"/>
                            <field name="guarantee_expiry_date" invisible="purpose not in ('guarantee', 'security')"
                                   decoration-danger="is_guarantee_expired"/>
                            <field name="is_guarantee_expired" invisible="1"/>
                            <field name="responsible_user_id"/>
                            <field name="approval_stage" invisible="state != 'pending_approval'"/>
                            <field name="accounting_status" widget="badge"
                                   decoration-success="accounting_status == 'posted'"
                                   decoration-warning="accounting_status == 'reversed'"
                                   decoration-muted="accounting_status in ('none', 'not_applicable')"/>
                        </group>
                        <group string="Amount &amp; Dates" name="amount_dates">
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="currency_id" readonly="state != 'draft'"
                                   groups="base.group_multi_currency"/>
                            <field name="company_amount"
                                   invisible="currency_id == company_currency_id"/>
                            <field name="manual_rate_allowed" invisible="1"/>
                            <field name="valuation_rate"
                                   invisible="currency_id == company_currency_id or not manual_rate_allowed"
                                   groups="sa_check_management.group_check_manager"/>
                            <field name="issue_date" readonly="state != 'draft'"/>
                            <field name="due_date" readonly="state != 'draft'"/>
                        </group>
                        <group string="Bank" name="bank">
                            <field name="journal_id" readonly="state != 'draft'"
                                   invisible="check_type != 'outgoing'"/>
                            <field name="journal_requires_leaf" invisible="1"/>
                            <field name="leaf_id" readonly="state != 'draft'" options="{'no_create': True}"
                                   invisible="check_type != 'outgoing' or not journal_id"
                                   required="journal_requires_leaf and check_type == 'outgoing' and state == 'draft'"/>
                            <field name="bank_id" readonly="state != 'draft' or check_type == 'outgoing'"
                                   required="check_type == 'incoming'"/>
                            <field name="bank_account_id"
                                   readonly="check_type == 'outgoing'"
                                   domain="[('partner_id', '=', partner_id if check_type == 'incoming' else company_partner_id)]"/>
                            <field name="company_id" readonly="state != 'draft'"
                                   groups="base.group_multi_company"/>
                        </group>
                        <group string="Drawer" name="drawer" invisible="check_type != 'incoming'">
                            <field name="drawer_is_partner" readonly="state != 'draft'"/>
                            <field name="drawer_name" invisible="drawer_is_partner"
                                   required="not drawer_is_partner" readonly="state != 'draft'"/>
                            <field name="drawer_account_number" readonly="state != 'draft'" required="check_type == 'incoming'"/>
                            <field name="current_location_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="current_holder_id" invisible="not current_holder_id"/>
                            <field name="duplicate_approved"
                                   groups="sa_check_management.group_check_manager"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Allocations" name="allocations"
                              invisible="purpose in ('guarantee', 'security')">
                            <button name="action_open_allocation_wizard" type="object"
                                    string="Add Invoices" icon="fa-plus" class="btn-secondary mb-2"
                                    invisible="state != 'draft' or check_type != 'incoming'"/>
                            <button name="action_open_allocation_wizard" type="object"
                                    string="Add Bills" icon="fa-plus" class="btn-secondary mb-2"
                                    invisible="state != 'draft' or check_type != 'outgoing'"/>
                            <field name="allocation_ids" readonly="state != 'draft'">
                                <list create="0" editable="bottom">
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="document_name"/>
                                    <field name="move_id" optional="hide" readonly="1"
                                           groups="account.group_account_invoice"/>
                                    <field name="date_maturity"/>
                                    <field name="line_residual"/>
                                    <field name="amount" sum="Allocated" readonly="1"/>
                                    <field name="payment_id" optional="hide"
                                           groups="account.group_account_invoice"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer" name="allocation_totals">
                                <field name="allocated_amount"/>
                                <field name="unallocated_amount"/>
                            </group>
                        </page>
                        <page string="Bank" name="bank_history" invisible="check_type != 'incoming' or not deposit_line_ids">
                            <group invisible="not bounce_count">
                                <group string="Last Bounce">
                                    <field name="bounce_count"/>
                                    <field name="last_bounce_date"/>
                                    <field name="last_bounce_reason_id"/>
                                </group>
                                <group>
                                    <field name="last_bounce_reference"/>
                                    <field name="last_bounce_note"/>
                                </group>
                            </group>
                            <field name="deposit_line_ids">
                                <list create="0" delete="0">
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="deposit_id"/>
                                    <field name="deposit_date"/>
                                    <field name="journal_id"/>
                                    <field name="attempt"/>
                                    <field name="state" widget="badge"/>
                                    <field name="result_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Endorsement" name="endorsement" invisible="not endorsement_line_ids">
                            <group>
                                <group>
                                    <field name="endorsed_partner_id"/>
                                    <field name="endorsed_date"/>
                                </group>
                                <group>
                                    <field name="endorsement_note"/>
                                </group>
                            </group>
                            <field name="endorsement_line_ids">
                                <list create="0" delete="0" decoration-muted="state == 'reversed'">
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="partner_id"/>
                                    <field name="document_name"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Exceptions" name="exceptions"
                              invisible="not (replaces_check_id or replaced_by_check_id or settled_date or legal_date or lost_date or stopped_date or discount_date or (check_type == 'outgoing' and bounce_count))">
                            <group>
                                <group string="Replacement" invisible="not (replaces_check_id or replaced_by_check_id)">
                                    <field name="replaces_check_id" invisible="not replaces_check_id"/>
                                    <field name="replaced_by_check_id" invisible="not replaced_by_check_id"/>
                                </group>
                                <group string="Settlement" invisible="not settled_date">
                                    <field name="settled_date"/>
                                    <field name="settle_note"/>
                                    <field name="settled_payment_ids" widget="many2many_tags"
                                           groups="account.group_account_invoice"/>
                                </group>
                                <group string="Legal Action" invisible="not legal_date">
                                    <field name="legal_date"/>
                                    <field name="legal_case_number"/>
                                    <field name="legal_lawyer_id"/>
                                    <field name="legal_court"/>
                                    <field name="legal_note"/>
                                </group>
                                <group string="Discounted at Bank" invisible="not discount_date">
                                    <field name="discount_journal_id"/>
                                    <field name="discount_date"/>
                                    <field name="discount_advance_amount"/>
                                    <field name="discount_fee"/>
                                    <field name="discount_net_amount"/>
                                </group>
                                <group string="Lost" invisible="not lost_date">
                                    <field name="lost_date"/>
                                    <field name="lost_reason"/>
                                </group>
                                <group string="Stop Payment" invisible="not stopped_date">
                                    <field name="stopped_date"/>
                                    <field name="stop_reference"/>
                                    <field name="stop_reason"/>
                                </group>
                                <group string="Bank Rejection" invisible="check_type != 'outgoing' or not bounce_count">
                                    <field name="last_bounce_date"/>
                                    <field name="last_bounce_reason_id"/>
                                    <field name="last_bounce_reference"/>
                                </group>
                            </group>
                        </page>
                        <page string="Approvals" name="approvals" invisible="not approval_line_ids">
                            <field name="approval_line_ids">
                                <list create="0" delete="0" decoration-muted="state == 'cancelled'"
                                      decoration-success="state == 'approved'" decoration-danger="state == 'rejected'">
                                    <field name="round"/>
                                    <field name="name"/>
                                    <field name="group_id"/>
                                    <field name="state" widget="badge"/>
                                    <field name="approver_id"/>
                                    <field name="decision_date"/>
                                    <field name="comment"/>
                                </list>
                            </field>
                        </page>
                        <page string="Custody" name="custody" invisible="not handover_ids">
                            <field name="handover_ids">
                                <list create="0" delete="0">
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="from_location_id"/>
                                    <field name="to_location_id"/>
                                    <field name="accepted_by_id"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="History" name="history">
                            <field name="event_ids">
                                <list create="0" edit="0" delete="0">
                                    <field name="date"/>
                                    <field name="event_type"/>
                                    <field name="old_state"/>
                                    <field name="new_state"/>
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Lifecycle Dates" name="lifecycle_dates">
                            <group>
                                <group string="Incoming" invisible="check_type != 'incoming'">
                                    <field name="received_date"/>
                                    <field name="collected_date"/>
                                    <field name="returned_date" invisible="not returned_date"/>
                                    <field name="return_recipient" invisible="not return_recipient"/>
                                    <field name="return_reason" invisible="not return_reason"/>
                                </group>
                                <group string="Outgoing" invisible="check_type != 'outgoing'">
                                    <field name="submitted_by_id" invisible="not submitted_by_id"/>
                                    <field name="approved_by_id" invisible="not approved_by_id"/>
                                    <field name="approved_date" invisible="not approved_date"/>
                                    <field name="rejection_reason" invisible="not rejection_reason"/>
                                    <field name="issued_date"/>
                                    <field name="delivered_date" invisible="not delivered_date"/>
                                    <field name="delivery_recipient" invisible="not delivery_recipient"/>
                                    <field name="cleared_date"/>
                                </group>
                                <group string="Cancellation" invisible="state != 'cancelled'">
                                    <field name="cancelled_date"/>
                                    <field name="cancel_reason"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Operational notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="check_check_view_list" model="ir.ui.view">
        <field name="name">check.check.view.list</field>
        <field name="model">check.check</field>
        <field name="arch" type="xml">
            <list string="Checks"
                  decoration-muted="state == 'cancelled'"
                  decoration-danger="state in ('bounced', 'rejected', 'legal')"
                  decoration-success="state in ('collected', 'cleared', 'settled')"
                  decoration-bf="accounting_attention">
                <header>
                    <button name="action_open_deposit_wizard" type="object" string="Deposit"
                            groups="sa_check_management.group_check_treasury"/>
                </header>
                <field name="check_type" column_invisible="True"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="company_currency_id" column_invisible="True"/>
                <field name="accounting_attention" column_invisible="True"/>
                <field name="name"/>
                <field name="check_number"/>
                <field name="partner_id"/>
                <field name="bank_id" optional="show"/>
                <field name="journal_id" optional="hide"/>
                <field name="purpose" optional="show"/>
                <field name="issue_date" optional="hide"/>
                <field name="due_date"/>
                <field name="amount"/>
                <field name="company_amount" sum="Total" optional="hide"/>
                <field name="unallocated_amount" optional="hide"/>
                <field name="accounting_status" optional="hide"/>
                <field name="responsible_user_id" widget="many2one_avatar_user" optional="hide"/>
                <field name="current_location_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('draft', 'pending_approval')"
                       decoration-warning="state in ('under_collection', 'issued', 'delivered', 'presented', 'endorsed')"
                       decoration-danger="state in ('bounced', 'rejected', 'legal', 'lost')"
                       decoration-success="state in ('collected', 'cleared', 'settled')"/>
            </list>
        </field>
    </record>

    <record id="check_check_view_search" model="ir.ui.view">
        <field name="name">check.check.view.search</field>
        <field name="model">check.check</field>
        <field name="arch" type="xml">
            <search string="Checks">
                <field name="name"/>
                <field name="check_number"/>
                <field name="partner_id"/>
                <field name="bank_id"/>
                <field name="reference"/>
                <field name="legal_case_number"/>
                <field name="amount"/>
                <filter name="filter_incoming" string="Incoming" domain="[('check_type', '=', 'incoming')]"/>
                <filter name="filter_outgoing" string="Outgoing" domain="[('check_type', '=', 'outgoing')]"/>
                <separator/>
                <filter name="filter_payment" string="Payment" domain="[('purpose', '=', 'payment')]"/>
                <filter name="filter_collateral" string="Guarantee / Security"
                        domain="[('purpose', 'in', ('guarantee', 'security'))]"/>
                <separator/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_under_collection" string="Under Collection"
                        domain="[('state', '=', 'under_collection')]"/>
                <filter name="filter_bounced" string="Bounced"
                        domain="[('state', 'in', ('bounced', 'rejected'))]"/>
                <filter name="filter_done" string="Collected / Cleared"
                        domain="[('state', 'in', ('collected', 'cleared'))]"/>
                <filter name="filter_cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter name="filter_due_today" string="Due Today"
                        domain="[('due_date', '=', context_today().strftime('%Y-%m-%d')),
                                 ('state', 'not in', ('collected', 'settled', 'replaced', 'returned', 'lost', 'endorsed', 'cleared', 'stopped', 'cancelled'))]"/>
                <filter name="filter_due_week" string="Due This Week"
                        domain="[('due_date', '&gt;=', context_today().strftime('%Y-%m-%d')),
                                 ('due_date', '&lt;=', (context_today() + relativedelta(days=7)).strftime('%Y-%m-%d')),
                                 ('state', 'not in', ('collected', 'settled', 'replaced', 'returned', 'lost', 'endorsed', 'cleared', 'stopped', 'cancelled'))]"/>
                <filter name="filter_overdue" string="Overdue"
                        domain="[('due_date', '&lt;', context_today().strftime('%Y-%m-%d')),
                                 ('state', 'not in', ('draft', 'collected', 'settled', 'replaced', 'returned', 'lost', 'endorsed', 'cleared', 'stopped', 'cancelled'))]"/>
                <filter name="filter_stale" string="Stale" domain="[('is_stale', '=', True)]"/>
                <filter name="filter_endorsed" string="Endorsed" domain="[('state', '=', 'endorsed')]"/>
                <filter name="filter_discounted" string="Discounted" domain="[('state', '=', 'discounted')]"/>
                <filter name="filter_attention" string="Needs Accounting Review" domain="[('accounting_attention', '=', True)]"/>
                <filter name="filter_waiting_me" string="Waiting My Approval"
                        domain="[('state', '=', 'pending_approval'), ('approval_line_ids.state', '=', 'pending'), ('approval_line_ids.group_id.users', 'in', uid)]"/>
                <filter name="filter_guarantee_expired" string="Expired Guarantees"
                        domain="[('is_guarantee_expired', '=', True)]"/>
                <filter name="filter_legal" string="Legal Action" domain="[('state', '=', 'legal')]"/>
                <filter name="filter_open_cases" string="Open Cases" domain="[('state', '=', 'legal')]"
                        invisible="1"/>
                <filter name="filter_closed_cases" string="Closed Cases"
                        domain="[('legal_case_number', '!=', False), ('state', '!=', 'legal')]"/>
                <separator/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                <group string="Group By">
                    <filter name="group_partner" string="Partner" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_bank" string="Bank" context="{'group_by': 'bank_id'}"/>
                    <filter name="group_type" string="Direction" context="{'group_by': 'check_type'}"/>
                    <filter name="group_purpose" string="Purpose" context="{'group_by': 'purpose'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_due_month" string="Due Month" context="{'group_by': 'due_date:month'}"/>
                    <filter name="group_currency" string="Currency" context="{'group_by': 'currency_id'}"/>
                    <filter name="group_responsible" string="Responsible" context="{'group_by': 'responsible_user_id'}"/>
                    <filter name="group_endorsee" string="Endorsed To" context="{'group_by': 'endorsed_partner_id'}"/>
                    <filter name="group_location" string="Held At" context="{'group_by': 'current_location_id'}"/>
                    <filter name="group_bounce_reason" string="Bounce Reason" context="{'group_by': 'last_bounce_reason_id'}"/>
                    <filter name="group_lawyer" string="Lawyer" context="{'group_by': 'legal_lawyer_id'}"/>
                    <filter name="group_court" string="Court" context="{'group_by': 'legal_court'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_check_incoming" model="ir.actions.act_window">
        <field name="name">Incoming Checks</field>
        <field name="res_model">check.check</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="check_check_view_search"/>
        <field name="domain">[('check_type', '=', 'incoming')]</field>
        <field name="context">{'default_check_type': 'incoming'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No incoming checks found.</p>
            <p>Create your first incoming check to start tracking customer checks and their collection status.</p>
        </field>
    </record>

    <record id="action_check_outgoing" model="ir.actions.act_window">
        <field name="name">Outgoing Checks</field>
        <field name="res_model">check.check</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="check_check_view_search"/>
        <field name="domain">[('check_type', '=', 'outgoing')]</field>
        <field name="context">{'default_check_type': 'outgoing'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No outgoing checks found.</p>
            <p>Create your first outgoing check to start tracking checks issued to vendors and other beneficiaries.</p>
        </field>
    </record>
</odoo>
