<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="check_maturity_report_view_pivot" model="ir.ui.view">
        <field name="name">check.maturity.report.view.pivot</field>
        <field name="model">check.maturity.report</field>
        <field name="arch" type="xml">
            <pivot string="Expected Cash Flow" sample="1">
                <field name="due_date" interval="month" type="row"/>
                <field name="amount_in" type="measure"/>
                <field name="amount_out" type="measure"/>
                <field name="amount_net" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="check_maturity_report_view_graph" model="ir.ui.view">
        <field name="name">check.maturity.report.view.graph</field>
        <field name="model">check.maturity.report</field>
        <field name="arch" type="xml">
            <graph string="Expected Cash Flow" type="bar" sample="1">
                <field name="due_date" interval="month"/>
                <field name="check_type"/>
                <field name="amount_net" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="check_maturity_report_view_list" model="ir.ui.view">
        <field name="name">check.maturity.report.view.list</field>
        <field name="model">check.maturity.report</field>
        <field name="arch" type="xml">
            <list string="Unresolved Checks" create="0" edit="0" delete="0">
                <field name="currency_id" column_invisible="True"/>
                <field name="check_id"/>
                <field name="check_type"/>
                <field name="partner_id"/>
                <field name="bank_id" optional="show"/>
                <field name="due_date"/>
                <field name="bucket" widget="badge"/>
                <field name="state" widget="badge"/>
                <field name="amount_in" sum="In"/>
                <field name="amount_out" sum="Out"/>
                <field name="amount_net" sum="Net" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="check_maturity_report_view_search" model="ir.ui.view">
        <field name="name">check.maturity.report.view.search</field>
        <field name="model">check.maturity.report</field>
        <field name="arch" type="xml">
            <search string="Checks">
                <field name="partner_id"/>
                <field name="bank_id"/>
                <filter name="filter_payment" string="Payment Checks" domain="[('category', '=', 'payment')]"/>
                <filter name="filter_collateral" string="Guarantee / Security" domain="[('category', '=', 'collateral')]"/>
                <separator/>
                <filter name="filter_incoming" string="Incoming" domain="[('check_type', '=', 'incoming')]"/>
                <filter name="filter_outgoing" string="Outgoing" domain="[('check_type', '=', 'outgoing')]"/>
                <separator/>
                <filter name="filter_overdue" string="Overdue" domain="[('bucket', '=', '1_overdue')]"/>
                <group string="Group By">
                    <filter name="group_month" string="Due Month" context="{'group_by': 'due_date:month'}"/>
                    <filter name="group_bucket" string="Maturity" context="{'group_by': 'bucket'}"/>
                    <filter name="group_type" string="Direction" context="{'group_by': 'check_type'}"/>
                    <filter name="group_partner" string="Partner" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_bank" string="Bank" context="{'group_by': 'bank_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_check_cash_flow" model="ir.actions.act_window">
        <field name="name">Expected Cash Flow</field>
        <field name="res_model">check.maturity.report</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="check_maturity_report_view_search"/>
        <field name="context">{'search_default_filter_payment': 1, 'pivot_column_groupby': ['check_type']}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No unresolved checks.</p>
            <p>Expected cash in and out from payment checks by due month. Guarantee checks are excluded.</p>
        </field>
    </record>

    <record id="action_check_aging" model="ir.actions.act_window">
        <field name="name">Check Maturity</field>
        <field name="res_model">check.maturity.report</field>
        <field name="view_mode">pivot,list,graph</field>
        <field name="search_view_id" ref="check_maturity_report_view_search"/>
        <field name="context">{'search_default_filter_payment': 1, 'pivot_row_groupby': ['bucket'], 'pivot_column_groupby': ['check_type']}</field>
    </record>
</odoo>
