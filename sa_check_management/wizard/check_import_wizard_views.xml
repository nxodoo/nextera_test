<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="check_import_wizard_view_form" model="ir.ui.view">
        <field name="name">check.import.wizard.view.form</field>
        <field name="model">check.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Legacy Checks">
                <div class="text-muted mb-3">
                    Each row becomes a check in its current state with one "Imported" history event.
                    Incoming checks can be received, under_collection (with the deposit bank journal) or bounced;
                    outgoing checks can be issued or delivered.
                </div>
                <group>
                    <group>
                        <field name="file" filename="filename"/>
                        <field name="filename" invisible="1"/>
                    </group>
                    <group>
                        <field name="post_entries"/>
                    </group>
                </group>
                <field name="result" invisible="not result" nolabel="1"/>
                <footer>
                    <button name="action_import" type="object" string="Import" class="btn-primary" data-hotkey="q"/>
                    <button name="action_validate" type="object" string="Check File" class="btn-secondary"/>
                    <button name="action_download_template" type="object" string="Download Template" class="btn-link"/>
                    <button string="Discard" special="cancel" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_check_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Legacy Checks</field>
        <field name="res_model">check.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
