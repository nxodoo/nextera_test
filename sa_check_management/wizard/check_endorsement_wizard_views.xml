<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="check_endorsement_wizard_view_form" model="ir.ui.view">
        <field name="name">check.endorsement.wizard.view.form</field>
        <field name="model">check.endorsement.wizard</field>
        <field name="arch" type="xml">
            <form string="Endorse Check">
                <field name="currency_id" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <group>
                    <group>
                        <field name="check_id"/>
                        <field name="customer_id"/>
                        <field name="available_amount"/>
                    </group>
                    <group>
                        <field name="partner_id" options="{'no_create': True}"/>
                        <field name="action_date"/>
                        <field name="selected_amount"/>
                        <field name="remaining_amount" decoration-danger="remaining_amount &lt; 0"/>
                    </group>
                </group>
                <div class="text-muted mb-2" invisible="not partner_id">
                    Tick the bills this check pays. Anything left stays as an advance to the endorsee.
                </div>
                <field name="line_ids" nolabel="1" invisible="not partner_id">
                    <list editable="bottom" create="0" delete="0" decoration-muted="not selected">
                        <field name="currency_id" column_invisible="True"/>
                        <field name="move_ref" force_save="1" column_invisible="True"/>
                        <field name="selected" widget="boolean_toggle" nolabel="1"/>
                        <field name="document_name" force_save="1"/>
                        <field name="document_date" force_save="1" optional="show"/>
                        <field name="date_due" force_save="1"/>
                        <field name="installment_count" force_save="1" optional="show"/>
                        <field name="open_amount" force_save="1" sum="Open"/>
                        <field name="amount" readonly="not selected" sum="Selected"/>
                    </list>
                </field>
                <field name="note" placeholder="Notes..."/>
                <footer>
                    <button name="action_confirm" type="object" string="Endorse" class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" special="cancel" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
