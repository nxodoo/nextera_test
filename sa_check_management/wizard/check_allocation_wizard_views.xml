<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="check_allocation_wizard_view_form" model="ir.ui.view">
        <field name="name">check.allocation.wizard.view.form</field>
        <field name="model">check.allocation.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Invoices">
                <field name="currency_id" invisible="1"/>
                <group>
                    <group>
                        <field name="check_id"/>
                        <field name="available_amount"/>
                    </group>
                    <group>
                        <field name="selected_amount"/>
                        <field name="remaining_amount" decoration-danger="remaining_amount &lt; 0"/>
                    </group>
                </group>
                <div class="text-muted mb-2">
                    Tick the documents to settle. The amount is spread over each document's
                    installments, earliest due date first.
                </div>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0"
                          decoration-muted="not selected">
                        <field name="currency_id" column_invisible="True"/>
                        <field name="move_ref" column_invisible="True"/>
                        <field name="selected" widget="boolean_toggle" nolabel="1"/>
                        <field name="document_name"/>
                        <field name="document_date" optional="show"/>
                        <field name="date_due"/>
                        <field name="installment_count" optional="show"/>
                        <field name="open_amount" sum="Open"/>
                        <field name="amount" readonly="not selected" sum="Selected"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" type="object" string="Add" class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Discard" special="cancel" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
