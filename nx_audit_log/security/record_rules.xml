<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- audit.log: company ownership (event visible to every company it touched) -->
    <record id="rule_audit_log_company" model="ir.rule">
        <field name="name">Audit events: own companies</field>
        <field name="model_id" ref="model_audit_log"/>
        <field name="domain_force">[('visible_company_ids', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_audit_user'))]"/>
    </record>
    <record id="rule_audit_log_shared" model="ir.rule">
        <field name="name">Audit events: shared records</field>
        <field name="model_id" ref="model_audit_log"/>
        <field name="domain_force">[('is_shared', '=', True)]</field>
        <field name="groups" eval="[(4, ref('group_audit_shared'))]"/>
    </record>
    <record id="rule_audit_log_global" model="ir.rule">
        <field name="name">Audit events: cross-company auditor</field>
        <field name="model_id" ref="model_audit_log"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_audit_global'))]"/>
    </record>

    <!-- audit.log.line: same ownership through the header -->
    <record id="rule_audit_line_company" model="ir.rule">
        <field name="name">Audit lines: own companies</field>
        <field name="model_id" ref="model_audit_log_line"/>
        <field name="domain_force">[('audit_log_id.visible_company_ids', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_audit_user'))]"/>
    </record>
    <record id="rule_audit_line_shared" model="ir.rule">
        <field name="name">Audit lines: shared records</field>
        <field name="model_id" ref="model_audit_log_line"/>
        <field name="domain_force">[('audit_log_id.is_shared', '=', True)]</field>
        <field name="groups" eval="[(4, ref('group_audit_shared'))]"/>
    </record>
    <record id="rule_audit_line_global" model="ir.rule">
        <field name="name">Audit lines: cross-company auditor</field>
        <field name="model_id" ref="model_audit_log_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_audit_global'))]"/>
    </record>
    <!-- Global (AND) rule: no side channel on fields restricted by groups -->
    <record id="rule_audit_line_field_visibility" model="ir.rule">
        <field name="name">Audit lines: field-level visibility</field>
        <field name="model_id" ref="model_audit_log_line"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)] if user.has_group('nx_audit_log.group_audit_restricted_fields') else ['|', ('restricted', '=', False), ('required_group_ids', 'in', user.groups_id.ids)]</field>
    </record>

    <!-- archive: same ownership model -->
    <record id="rule_audit_archive_company" model="ir.rule">
        <field name="name">Archived events: own companies</field>
        <field name="model_id" ref="model_audit_log_archive"/>
        <field name="domain_force">['|', ('visible_company_ids', 'in', company_ids), ('is_shared', '=', True)]</field>
        <field name="groups" eval="[(4, ref('group_audit_user'))]"/>
    </record>
    <record id="rule_audit_archive_global" model="ir.rule">
        <field name="name">Archived events: cross-company auditor</field>
        <field name="model_id" ref="model_audit_log_archive"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_audit_global'))]"/>
    </record>
    <record id="rule_audit_alert_company" model="ir.rule">
        <field name="name">Alerts: own companies</field>
        <field name="model_id" ref="model_audit_alert"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_audit_user'))]"/>
    </record>
</odoo>
