<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="audit_batch_view_list" model="ir.ui.view">
        <field name="name">audit.batch.list</field>
        <field name="model">audit.batch</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="create_date" string="Date"/>
                <field name="name"/>
                <field name="batch_type"/>
                <field name="model_name"/>
                <field name="user_id"/>
                <field name="created_count"/>
                <field name="updated_count"/>
                <field name="deleted_count"/>
                <field name="failed_count"/>
            </list>
        </field>
    </record>
    <record id="audit_batch_view_form" model="ir.ui.view">
        <field name="name">audit.batch.form</field>
        <field name="model">audit.batch</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_logs" type="object" class="oe_stat_button" icon="fa-list">
                            <field name="total_count" widget="statinfo" string="Events"/>
                        </button>
                    </div>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="batch_type"/>
                            <field name="model_name"/>
                            <field name="user_id"/>
                            <field name="correlation_id"/>
                        </group>
                        <group>
                            <field name="created_count"/>
                            <field name="updated_count"/>
                            <field name="deleted_count"/>
                            <field name="failed_count"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="audit_batch_action" model="ir.actions.act_window">
        <field name="name">Batches</field>
        <field name="res_model">audit.batch</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
