<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_seal_events" model="ir.cron">
        <field name="name">Audit: seal events (hash chain)</field>
        <field name="model_id" ref="model_audit_chain"/>
        <field name="state">code</field>
        <field name="code">model._cron_seal()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
    <record id="cron_dispatch_alerts" model="ir.cron">
        <field name="name">Audit: dispatch alerts</field>
        <field name="model_id" ref="model_audit_alert"/>
        <field name="state">code</field>
        <field name="code">model._cron_dispatch()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
    <record id="cron_retention" model="ir.cron">
        <field name="name">Audit: retention (archive / purge / checkpoints)</field>
        <field name="model_id" ref="model_audit_retention_policy"/>
        <field name="state">code</field>
        <field name="code">model._cron_retention()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
    <record id="cron_verify_integrity" model="ir.cron">
        <field name="name">Audit: verify integrity</field>
        <field name="model_id" ref="model_audit_integrity_check"/>
        <field name="state">code</field>
        <field name="code">model._cron_verify()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
</odoo>
