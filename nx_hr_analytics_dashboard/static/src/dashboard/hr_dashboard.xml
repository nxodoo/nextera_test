<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="nx_hr_analytics_dashboard.HrAnalyticsDashboard">
    <div class="o_nx_hr_dash">

        <!-- ── Top bar ─────────────────────────────────────────────── -->
        <div class="o_nx_hr_dash_topbar">
            <div class="o_nx_hr_dash_toolbar">
                <div class="o_nx_hr_filter">
                    <label>Branch:</label>
                    <select t-on-change="(ev) => this.onFilterChange('company_id', ev)">
                        <option value="">All Branches</option>
                        <t t-foreach="state.data?.filter_options?.companies || []" t-as="c" t-key="c.id">
                            <option t-att-value="c.id" t-att-selected="state.filters.company_id === c.id">
                                <t t-esc="c.name"/>
                            </option>
                        </t>
                    </select>
                </div>
                <div class="o_nx_hr_filter">
                    <label>Department:</label>
                    <select t-on-change="(ev) => this.onFilterChange('department_id', ev)">
                        <option value="">All Departments</option>
                        <t t-foreach="state.data?.filter_options?.departments || []" t-as="d" t-key="d.id">
                            <option t-att-value="d.id" t-att-selected="state.filters.department_id === d.id">
                                <t t-esc="d.name"/>
                            </option>
                        </t>
                    </select>
                </div>
                <div class="o_nx_hr_filter" t-if="state.activeTab === 'payroll'">
                    <label>Month:</label>
                    <select t-on-change="(ev) => this.onMonthChange(ev)">
                        <t t-foreach="state.payroll?.month_options || []" t-as="m" t-key="m.value">
                            <option t-att-value="m.value" t-att-selected="state.filters.month === m.value">
                                <t t-esc="m.label"/>
                            </option>
                        </t>
                    </select>
                </div>
                <button class="o_nx_hr_btn o_nx_hr_btn_light" t-on-click="clearFilters">
                    <i class="fa fa-times me-1"/>Clear
                </button>
            </div>
        </div>

        <!-- ── Header + tabs ───────────────────────────────────────── -->
        <div class="o_nx_hr_dash_header">
            <div>
                <h1>HR Analytics Dashboard</h1>
                <p>Executive overview of HR metrics, compliance status, and actionable alerts</p>
            </div>
            <div class="o_nx_hr_tabs">
                <button t-att-class="{'o_active': state.activeTab === 'dashboard'}"
                        t-on-click="() => this.setTab('dashboard')">Dashboard</button>
                <button t-att-class="{'o_active': state.activeTab === 'payroll'}"
                        t-on-click="() => this.setTab('payroll')">Payroll Tax</button>
                <button t-att-class="{'o_active': state.activeTab === 'documents'}"
                        t-on-click="() => this.setTab('documents')">Documents</button>
                <button t-att-class="{'o_active': state.activeTab === 'insurance'}"
                        t-on-click="() => this.setTab('insurance')">Insurance</button>
            </div>
        </div>

        <!-- ── Loading overlay ─────────────────────────────────────── -->
        <div t-if="state.loading" class="o_nx_hr_loading">
            <i class="fa fa-circle-o-notch fa-spin"/>
        </div>

        <!-- ── DASHBOARD TAB ───────────────────────────────────────── -->
        <div t-if="state.activeTab === 'dashboard'" class="o_nx_hr_tabpane">

            <!-- KPI cards -->
            <div class="o_nx_hr_kpis">
                <t t-foreach="kpiCards" t-as="c" t-key="c.key">
                    <div t-attf-class="o_nx_hr_kpi {{ c.clickable ? 'o_clickable' : '' }}"
                         t-attf-style="--accent:{{c.accent}}"
                         t-on-click="() => c.clickable ? this.openKpi(c.key) : null">
                        <div class="o_nx_hr_kpi_body">
                            <span class="o_nx_hr_kpi_label" t-esc="c.label"/>
                            <span class="o_nx_hr_kpi_value" t-esc="fmt(c.value)"/>
                            <t t-if="c.sub and c.sub.kind === 'delta'">
                                <span class="o_nx_hr_kpi_delta o_up" t-if="c.sub.value >= 0">
                                    <i class="fa fa-arrow-up"/> <t t-esc="fmt(c.sub.value)"/> this month
                                </span>
                                <span class="o_nx_hr_kpi_delta o_down" t-else="">
                                    <i class="fa fa-arrow-down"/> <t t-esc="fmt(-c.sub.value)"/> this month
                                </span>
                            </t>
                            <span t-if="c.sub and c.sub.kind === 'note'"
                                  class="o_nx_hr_kpi_delta o_muted" t-esc="c.sub.text"/>
                        </div>
                        <div class="o_nx_hr_kpi_icon"><i t-attf-class="fa {{c.icon}}"/></div>
                        <i t-if="c.clickable" class="fa fa-arrow-right o_nx_hr_kpi_go"/>
                    </div>
                </t>
            </div>

            <!-- Row 1: department bar + branch list + insurance donut -->
            <div class="o_nx_hr_row">
                <div class="o_nx_hr_card o_span2">
                    <h3>Headcount by Department</h3>
                    <div class="o_nx_hr_chartbox"><canvas t-ref="deptChart"/></div>
                </div>
                <div class="o_nx_hr_card">
                    <h3>Top Paid Job Positions</h3>
                    <table class="o_nx_hr_minitable">
                        <thead>
                            <tr><th>Job Position</th><th class="o_num">Contracts</th><th class="o_num">Avg. Salary</th></tr>
                        </thead>
                        <tbody>
                            <t t-foreach="state.data?.top_paid_positions || []" t-as="row" t-key="row.id">
                                <tr class="o_clickable_row"
                                    t-on-click="() => this.openEmployeesFiltered('job_id', row.id, row.label)">
                                    <td t-esc="row.label"/>
                                    <td class="o_num" t-esc="row.contracts"/>
                                    <td class="o_num o_ok">
                                        <t t-esc="fmt(row.avg_salary)"/> <t t-esc="state.data.currency"/>
                                    </td>
                                </tr>
                            </t>
                            <tr t-if="!(state.data?.top_paid_positions || []).length">
                                <td colspan="3" class="o_empty">No running contracts.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="o_nx_hr_card" t-if="state.data?.social_insurance">
                    <h3>Social Insurance Status</h3>
                    <div class="o_nx_hr_donutwrap">
                        <div class="o_nx_hr_donut"><canvas t-ref="insuranceChart"/></div>
                        <div class="o_nx_hr_legend">
                            <div><span class="o_dot" style="background:#22C55E"/>Insured
                                <b t-esc="fmt(state.data.social_insurance.insured)"/></div>
                            <div><span class="o_dot" style="background:#EF4444"/>Not Insured
                                <b t-esc="fmt(state.data.social_insurance.not_insured)"/></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Row 2: trend line + document compliance donut -->
            <div class="o_nx_hr_row">
                <div class="o_nx_hr_card o_span2">
                    <h3>Headcount Trend — Last 12 Months</h3>
                    <div class="o_nx_hr_chartbox"><canvas t-ref="trendChart"/></div>
                </div>
                <div class="o_nx_hr_card" t-if="state.data?.document_compliance">
                    <h3>Document Compliance</h3>
                    <div class="o_nx_hr_donutwrap">
                        <div class="o_nx_hr_donut"><canvas t-ref="complianceChart"/></div>
                        <div class="o_nx_hr_legend">
                            <div><span class="o_dot" style="background:#22C55E"/>Complete
                                <b t-esc="fmt(state.data.document_compliance.complete)"/></div>
                            <div><span class="o_dot" style="background:#F59E0B"/>Incomplete
                                <b t-esc="fmt(state.data.document_compliance.incomplete)"/></div>
                            <div><span class="o_dot" style="background:#EF4444"/>Expired
                                <b t-esc="fmt(state.data.document_compliance.expired)"/></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Row 3: turnover + payroll tax card -->
            <div class="o_nx_hr_row">
                <div class="o_nx_hr_card o_span2">
                    <h3>Employee Turnover Rate (%)</h3>
                    <div class="o_nx_hr_chartbox"><canvas t-ref="turnoverChart"/></div>
                </div>
                <div class="o_nx_hr_card o_nx_hr_paytax" t-if="state.data?.payroll_tax">
                    <h3>Payroll Tax</h3>
                    <span class="o_nx_hr_badge">Active</span>
                    <div class="o_nx_hr_paytax_row">
                        <span>Configuration</span><b t-esc="state.data.payroll_tax.name"/>
                    </div>
                    <div class="o_nx_hr_paytax_row">
                        <span>Total Employees</span><b t-esc="fmt(state.data.payroll_tax.total_employees)"/>
                    </div>
                    <button class="o_nx_hr_btn o_nx_hr_btn_primary mt-2"
                            t-on-click="() => this.openAlert({action:'payroll_tax'})">
                        Open Configuration <i class="fa fa-arrow-right ms-1"/>
                    </button>
                </div>
            </div>

            <!-- Alerts -->
            <div class="o_nx_hr_card o_nx_hr_alerts" t-if="(state.data?.alerts || []).length">
                <div class="o_nx_hr_alerts_head">
                    <h3>Alerts &amp; Required Actions</h3>
                    <span class="o_nx_hr_badge o_danger">
                        <t t-esc="state.data.alerts.length"/> active alerts
                    </span>
                </div>
                <t t-foreach="state.data.alerts" t-as="alert" t-key="alert_index">
                    <div t-attf-class="o_nx_hr_alert o_{{alert.type}}">
                        <div class="o_nx_hr_alert_txt">
                            <b t-esc="alert.title"/>
                            <small t-esc="alert.subtitle"/>
                        </div>
                        <button class="o_nx_hr_btn o_nx_hr_btn_light"
                                t-on-click="() => this.openAlert(alert)">
                            <t t-esc="alert.action_label"/>
                        </button>
                    </div>
                </t>
            </div>
        </div>

        <!-- ── PAYROLL TAX TAB ─────────────────────────────────────── -->
        <div t-if="state.activeTab === 'payroll'" class="o_nx_hr_tabpane">
            <div t-if="state.payrollLoading" class="o_nx_hr_loading">
                <i class="fa fa-circle-o-notch fa-spin"/>
            </div>
            <t t-if="state.payroll">
                <!-- Declaration header card -->
                <div class="o_nx_hr_card o_nx_hr_decl">
                    <div class="o_nx_hr_decl_left">
                        <div class="o_nx_hr_decl_title">
                            <h2>Payroll Tax Declaration — <t t-esc="state.payroll.month_label"/></h2>
                        </div>
                        <div class="o_nx_hr_decl_meta">
                            <span t-if="state.payroll.config_name">Config: <b t-esc="state.payroll.config_name"/> · </span>
                            <span>Filing Deadline: <b class="o_danger" t-esc="state.payroll.filing_deadline"/></span>
                            <span t-if="state.payroll.source === 'projected'" class="o_nx_hr_badge o_muted-badge ms-2">
                                Projected (no posted payslips)
                            </span>
                        </div>
                    </div>
                    <div class="o_nx_hr_decl_actions">
                        <button class="o_nx_hr_btn o_nx_hr_btn_light"
                                t-on-click="exportDashboard">Export</button>
                        <button class="o_nx_hr_btn o_nx_hr_btn_light"
                                t-on-click="exportDashboard">Print</button>
                    </div>
                </div>

                <!-- Summary tiles -->
                <div class="o_nx_hr_paytiles">
                    <div class="o_nx_hr_tile"><span>No. of Employees</span><b t-esc="fmt(state.payroll.totals.employees)"/></div>
                    <div class="o_nx_hr_tile"><span>Total Wages</span><b t-esc="fmt(state.payroll.totals.gross)"/><small t-esc="state.payroll.currency"/></div>
                    <div class="o_nx_hr_tile"><span>Total Exemptions</span><b t-esc="fmt(state.payroll.totals.exemptions)"/><small t-esc="state.payroll.currency"/></div>
                    <div class="o_nx_hr_tile"><span>Taxable Base</span><b t-esc="fmt(state.payroll.totals.taxable_base)"/><small t-esc="state.payroll.currency"/></div>
                    <div class="o_nx_hr_tile o_accent"><span>Total Tax Due</span><b t-esc="fmt(state.payroll.totals.tax_due)"/><small t-esc="state.payroll.currency"/></div>
                    <div class="o_nx_hr_tile"><span>Tax / Gross Wage</span><b><t t-esc="state.payroll.totals.tax_ratio"/>%</b></div>
                </div>


                <!-- Breakdown table -->
                <div class="o_nx_hr_card">
                    <div class="o_nx_hr_tabletools">
                        <input type="text" class="o_nx_hr_search" placeholder="Search by name, code, or national ID..."
                               t-model="state.payrollSearch"/>
                        <span class="o_nx_hr_count">Showing <t t-esc="payrollRows.length"/> of <t t-esc="state.payroll.rows.length"/> records</span>
                    </div>
                    <div class="o_nx_hr_tablewrap">
                        <table class="o_nx_hr_table">
                            <thead>
                                <tr>
                                    <th>Emp. Code</th><th>Employee Name</th><th>National ID</th>
                                    <th>Department</th><th>Job Title</th>
                                    <th class="o_num">Gross Wage</th><th class="o_num">Insurance</th>
                                    <th class="o_num">Exemptions</th><th class="o_num">Deductions</th>
                                    <th class="o_num">Taxable Base</th><th class="o_num">Tax Due</th>
                                    <th class="o_num">Net Salary</th><th>Status</th><th>Notes</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="payrollRows" t-as="r" t-key="r.code + '_' + r_index">
                                    <tr t-att-class="r.status === 'error' ? 'o_row_error' : (r.status === 'warning' ? 'o_row_warning' : '')">
                                        <td class="o_code" t-esc="r.code"/>
                                        <td t-esc="r.name"/>
                                        <td t-att-class="r.national_id === '---' ? 'o_danger' : ''" t-esc="r.national_id"/>
                                        <td t-esc="r.department"/>
                                        <td t-esc="r.job"/>
                                        <td class="o_num" t-esc="fmt(r.gross)"/>
                                        <td class="o_num" t-esc="fmt(r.insurance)"/>
                                        <td class="o_num" t-esc="fmt(r.exemptions)"/>
                                        <td class="o_num" t-esc="fmt(r.deductions)"/>
                                        <td class="o_num" t-esc="fmt(r.taxable_base)"/>
                                        <td class="o_num o_danger" t-esc="fmt(r.tax_due)"/>
                                        <td class="o_num o_ok" t-esc="fmt(r.net)"/>
                                        <td>
                                            <span t-attf-class="o_nx_hr_status o_{{r.status}}" t-esc="statusLabel(r.status)"/>
                                        </td>
                                        <td class="o_note" t-esc="r.note || '—'"/>
                                    </tr>
                                </t>
                                <tr t-if="!payrollRows.length">
                                    <td colspan="14" class="o_empty">No payroll records for this period.</td>
                                </tr>
                            </tbody>
                            <tfoot t-if="payrollRows.length">
                                <tr>
                                    <td colspan="5"><b><t t-esc="state.payroll.totals.employees"/> employees</b></td>
                                    <td class="o_num"><b t-esc="fmt(state.payroll.totals.gross)"/></td>
                                    <td class="o_num"><b t-esc="fmt(state.payroll.totals.insurance)"/></td>
                                    <td class="o_num"><b t-esc="fmt(state.payroll.totals.exemptions)"/></td>
                                    <td class="o_num"><b t-esc="fmt(state.payroll.totals.deductions)"/></td>
                                    <td class="o_num"><b t-esc="fmt(state.payroll.totals.taxable_base)"/></td>
                                    <td class="o_num"><b t-esc="fmt(state.payroll.totals.tax_due)"/></td>
                                    <td class="o_num"><b t-esc="fmt(state.payroll.totals.net)"/></td>
                                    <td colspan="2"/>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </t>
        </div>

        <!-- ── DOCUMENTS TAB ───────────────────────────────────────── -->
        <div t-if="state.activeTab === 'documents'" class="o_nx_hr_tabpane">
            <div t-if="state.documentsLoading" class="o_nx_hr_loading"><i class="fa fa-circle-o-notch fa-spin"/></div>
            <div t-if="!state.documentsLoading and !state.documents" class="o_nx_hr_card o_nx_hr_placeholder">
                <i class="fa fa-folder-open-o"/><h3>Documents feature not available</h3>
                <p>The employee document module is not installed on this database.</p>
            </div>
            <t t-if="state.documents">
                <div class="o_nx_hr_paytiles">
                    <div class="o_nx_hr_tile"><span>Total Employees</span><b t-esc="fmt(state.documents.kpis.total_employees)"/></div>
                    <div class="o_nx_hr_tile"><span>Complete Files</span><b class="o_v_ok" t-esc="fmt(state.documents.kpis.complete_files)"/></div>
                    <div class="o_nx_hr_tile"><span>Incomplete Files</span><b class="o_v_warn" t-esc="fmt(state.documents.kpis.incomplete_files)"/></div>
                    <div class="o_nx_hr_tile"><span>Missing Documents</span><b class="o_v_warn" t-esc="fmt(state.documents.kpis.missing_documents)"/></div>
                    <div class="o_nx_hr_tile"><span>Expired Documents</span><b class="o_v_danger" t-esc="fmt(state.documents.kpis.expired_documents)"/></div>
                    <div class="o_nx_hr_tile"><span>Expiring Soon</span><b class="o_v_danger" t-esc="fmt(state.documents.kpis.expiring_soon)"/></div>
                </div>
                <div class="o_nx_hr_row">
                    <div class="o_nx_hr_card">
                        <h3>Document Compliance</h3>
                        <div class="o_nx_hr_donutwrap">
                            <div class="o_nx_hr_donut"><canvas t-ref="docComplianceChart"/></div>
                            <div class="o_nx_hr_legend">
                                <div><span class="o_dot" style="background:#22C55E"/>Complete <b t-esc="fmt(state.documents.compliance.complete)"/></div>
                                <div><span class="o_dot" style="background:#F59E0B"/>Incomplete <b t-esc="fmt(state.documents.compliance.incomplete)"/></div>
                                <div><span class="o_dot" style="background:#EF4444"/>Expired <b t-esc="fmt(state.documents.compliance.expired)"/></div>
                            </div>
                        </div>
                    </div>
                    <div class="o_nx_hr_card o_span2">
                        <h3>Missing Documents by Type</h3>
                        <div class="o_nx_hr_chartbox"><canvas t-ref="missingTypeChart"/></div>
                    </div>
                </div>
                <div class="o_nx_hr_card">
                    <div class="o_nx_hr_tabletools">
                        <input type="text" class="o_nx_hr_search" placeholder="Search by employee name..." t-model="state.docSearch"/>
                        <select class="o_nx_hr_select" t-model="state.docFilter">
                            <option value="all">All</option>
                            <option value="complete">Complete</option>
                            <option value="incomplete">Incomplete</option>
                            <option value="expired">Expired</option>
                        </select>
                        <span class="o_nx_hr_count">Showing <t t-esc="docRows.length"/> of <t t-esc="state.documents.rows.length"/> records</span>
                    </div>
                    <div class="o_nx_hr_tablewrap">
                        <table class="o_nx_hr_table">
                            <thead><tr>
                                <th>Emp. Code</th><th>Employee Name</th><th>Department</th><th>Job Title</th>
                                <th class="o_num">Required</th><th class="o_num">Complete</th><th class="o_num">Missing</th>
                                <th class="o_num">Expired</th><th class="o_num">% Complete</th><th>File Status</th><th>Actions</th>
                            </tr></thead>
                            <tbody>
                                <t t-foreach="docRows" t-as="r" t-key="r.id">
                                    <tr>
                                        <td class="o_code" t-esc="r.code"/>
                                        <td t-esc="r.name"/>
                                        <td t-esc="r.department"/>
                                        <td t-esc="r.job"/>
                                        <td class="o_num" t-esc="r.required"/>
                                        <td class="o_num o_ok" t-esc="r.complete"/>
                                        <td class="o_num o_danger" t-esc="r.missing"/>
                                        <td class="o_num o_danger" t-esc="r.expired"/>
                                        <td class="o_num"><b t-esc="r.pct"/>%</td>
                                        <td><span t-attf-class="o_nx_hr_status o_{{r.status}}" t-esc="statusLabel(r.status)"/></td>
                                        <td>
                                            <button class="o_nx_hr_link" t-on-click="() => this.openEmployee(r.id)">View</button>
                                            <button class="o_nx_hr_link" t-on-click="() => this.openEmployee(r.id)">Upload</button>
                                        </td>
                                    </tr>
                                </t>
                                <tr t-if="!docRows.length"><td colspan="11" class="o_empty">No records.</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </t>
        </div>

        <!-- ── INSURANCE TAB ───────────────────────────────────────── -->
        <div t-if="state.activeTab === 'insurance'" class="o_nx_hr_tabpane">
            <div t-if="state.insuranceLoading" class="o_nx_hr_loading"><i class="fa fa-circle-o-notch fa-spin"/></div>
            <div t-if="!state.insuranceLoading and !state.insurance" class="o_nx_hr_card o_nx_hr_placeholder">
                <i class="fa fa-shield"/><h3>Insurance data not available</h3>
                <p>The contract field "Social Insurance Reference Amount" (Egypt payroll) is not present on this database.</p>
            </div>
            <t t-if="state.insurance">
                <div class="o_nx_hr_paytiles">
                    <div class="o_nx_hr_tile"><span>Total Employees</span><b t-esc="fmt(state.insurance.kpis.total_employees)"/></div>
                    <div class="o_nx_hr_tile"><span>Insured</span><b class="o_v_ok" t-esc="fmt(state.insurance.kpis.insured)"/></div>
                    <div class="o_nx_hr_tile"><span>Not Insured</span><b class="o_v_danger" t-esc="fmt(state.insurance.kpis.not_insured)"/></div>
                    <div class="o_nx_hr_tile o_accent"><span>Coverage</span><b><t t-esc="state.insurance.kpis.coverage"/>%</b></div>
                    <div class="o_nx_hr_tile"><span>Total Reference</span><b t-esc="fmt(state.insurance.kpis.total_reference)"/><small t-esc="state.insurance.currency"/></div>
                    <div class="o_nx_hr_tile"><span>No Contract</span><b class="o_v_warn" t-esc="fmt(state.insurance.kpis.no_contract)"/></div>
                </div>
                <div class="o_nx_hr_row">
                    <div class="o_nx_hr_card">
                        <h3>Social Insurance Status</h3>
                        <div class="o_nx_hr_donutwrap">
                            <div class="o_nx_hr_donut"><canvas t-ref="insStatusChart"/></div>
                            <div class="o_nx_hr_legend">
                                <div><span class="o_dot" style="background:#22C55E"/>Insured <b t-esc="fmt(state.insurance.status.insured)"/></div>
                                <div><span class="o_dot" style="background:#EF4444"/>Not Insured <b t-esc="fmt(state.insurance.status.not_insured)"/></div>
                            </div>
                        </div>
                    </div>
                    <div class="o_nx_hr_card o_span2">
                        <h3>Insured Employees by Department</h3>
                        <div class="o_nx_hr_chartbox"><canvas t-ref="insTrendChart"/></div>
                    </div>
                </div>
                <div class="o_nx_hr_card">
                    <div class="o_nx_hr_tabletools">
                        <input type="text" class="o_nx_hr_search" placeholder="Search by name, code, or national ID..." t-model="state.insSearch"/>
                        <select class="o_nx_hr_select" t-model="state.insFilter">
                            <option value="all">All</option>
                            <option value="insured">Insured</option>
                            <option value="not_insured">Not Insured</option>
                        </select>
                        <span class="o_nx_hr_count">Showing <t t-esc="insRows.length"/> of <t t-esc="state.insurance.rows.length"/> records</span>
                    </div>
                    <div class="o_nx_hr_tablewrap">
                        <table class="o_nx_hr_table">
                            <thead><tr>
                                <th>Emp. Code</th><th>Employee Name</th><th>National ID</th><th>Department</th>
                                <th>Contract Start</th><th class="o_num">Basic Wage</th>
                                <th class="o_num">Reference Amount</th><th>Status</th><th>Actions</th>
                            </tr></thead>
                            <tbody>
                                <t t-foreach="insRows" t-as="r" t-key="r.id">
                                    <tr t-att-class="r.status === 'not_insured' ? 'o_row_error' : ''">
                                        <td class="o_code" t-esc="r.code"/>
                                        <td t-esc="r.name"/>
                                        <td t-att-class="r.national_id === '---' ? 'o_danger' : ''" t-esc="r.national_id"/>
                                        <td t-esc="r.department"/>
                                        <td t-esc="r.contract_start"/>
                                        <td class="o_num" t-esc="fmt(r.basic_wage)"/>
                                        <td class="o_num" t-esc="fmt(r.reference_amount)"/>
                                        <td><span t-attf-class="o_nx_hr_status o_{{r.status === 'insured' ? 'approved' : 'error'}}"
                                                  t-esc="r.status === 'insured' ? 'Insured' : 'Not Insured'"/></td>
                                        <td><button class="o_nx_hr_link" t-on-click="() => this.openEmployee(r.id)">View</button></td>
                                    </tr>
                                </t>
                                <tr t-if="!insRows.length"><td colspan="9" class="o_empty">No records.</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </t>
        </div>

    </div>
</t>

</templates>
