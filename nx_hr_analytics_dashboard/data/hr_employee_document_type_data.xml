<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Pre-seeded document types (extensible by HR in Configuration). -->
        <record id="doc_type_national_id" model="hr.employee.document.type">
            <field name="name">National ID</field>
            <field name="code">national_id</field>
            <field name="sequence">10</field>
            <field name="mandatory" eval="True"/>
            <field name="expiry_required" eval="True"/>
            <field name="applies_to_gender">all</field>
        </record>

        <record id="doc_type_military_service" model="hr.employee.document.type">
            <field name="name">Military Service</field>
            <field name="code">military_service</field>
            <field name="sequence">20</field>
            <field name="mandatory" eval="True"/>
            <field name="expiry_required" eval="False"/>
            <!-- Applies to male employees only. -->
            <field name="applies_to_gender">male</field>
        </record>

        <record id="doc_type_form_111" model="hr.employee.document.type">
            <field name="name">Form 111</field>
            <field name="code">form_111</field>
            <field name="sequence">30</field>
            <field name="mandatory" eval="True"/>
            <field name="applies_to_gender">all</field>
        </record>

        <record id="doc_type_insurance_no" model="hr.employee.document.type">
            <field name="name">Insurance No.</field>
            <field name="code">insurance_no</field>
            <field name="sequence">40</field>
            <field name="mandatory" eval="True"/>
            <field name="applies_to_gender">all</field>
        </record>

        <record id="doc_type_education_certificate" model="hr.employee.document.type">
            <field name="name">Education Certificate</field>
            <field name="code">education_certificate</field>
            <field name="sequence">50</field>
            <field name="mandatory" eval="True"/>
            <field name="applies_to_gender">all</field>
        </record>

        <record id="doc_type_criminal_record" model="hr.employee.document.type">
            <field name="name">Criminal Record</field>
            <field name="code">criminal_record</field>
            <field name="sequence">60</field>
            <field name="mandatory" eval="True"/>
            <field name="expiry_required" eval="True"/>
            <field name="applies_to_gender">all</field>
        </record>

        <record id="doc_type_personal_photos" model="hr.employee.document.type">
            <field name="name">Personal Photos</field>
            <field name="code">personal_photos</field>
            <field name="sequence">70</field>
            <field name="mandatory" eval="True"/>
            <field name="applies_to_gender">all</field>
        </record>
    </data>
</odoo>
