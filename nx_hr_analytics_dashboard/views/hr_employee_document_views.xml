<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Employee Document: editable list (used inside the employee tab) ── -->
    <record id="view_hr_employee_document_list" model="ir.ui.view">
        <field name="name">hr.employee.document.list</field>
        <field name="model">hr.employee.document</field>
        <field name="arch" type="xml">
            <list string="Documents" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="document_type_id"
                       options="{'no_create': True, 'no_open': True}"/>
                <field name="expiry_required" column_invisible="1"/>
                <field name="mandatory" optional="show"/>
                <field name="reference" optional="show"/>
                <field name="document_file" filename="document_filename" widget="nx_file_dropzone"/>
                <field name="document_filename" column_invisible="1"/>
                <field name="issue_date" optional="hide"/>
                <field name="expiry_date" invisible="not expiry_required" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'complete'"
                       decoration-warning="state == 'expiring'"
                       decoration-danger="state in ('missing','expired')"/>
                <field name="notes" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_hr_employee_document_form" model="ir.ui.view">
        <field name="name">hr.employee.document.form</field>
        <field name="model">hr.employee.document</field>
        <field name="arch" type="xml">
            <form string="Document">
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="document_type_id"/>
                            <field name="reference"/>
                            <field name="expiry_required" invisible="1"/>
                        </group>
                        <group>
                            <field name="issue_date"/>
                            <field name="expiry_date" invisible="not expiry_required"/>
                            <field name="state"/>
                        </group>
                    </group>
                    <!-- Named so other modules can anchor onto these groups;
                         view inheritance may not select on 'string'. -->
                    <group string="File" name="file">
                        <field name="document_file" filename="document_filename"
                               nolabel="1" widget="nx_file_dropzone"/>
                        <field name="document_filename" invisible="1"/>
                    </group>
                    <group string="Notes" name="notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Compliance search + standalone report action -->
    <record id="view_hr_employee_document_search" model="ir.ui.view">
        <field name="name">hr.employee.document.search</field>
        <field name="model">hr.employee.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="document_type_id"/>
                <filter name="missing" string="Missing" domain="[('state','=','missing')]"/>
                <filter name="expired" string="Expired" domain="[('state','=','expired')]"/>
                <filter name="expiring" string="Expiring Soon" domain="[('state','=','expiring')]"/>
                <filter name="mandatory" string="Mandatory" domain="[('mandatory','=',True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_status" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_type" string="Document Type" context="{'group_by': 'document_type_id'}"/>
                    <filter name="group_dept" string="Department" context="{'group_by': 'department_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Compliance list: includes the Employee (used by the standalone
         Document Compliance action, not the embedded employee-form tab). -->
    <record id="view_hr_employee_document_compliance_list" model="ir.ui.view">
        <field name="name">hr.employee.document.compliance.list</field>
        <field name="model">hr.employee.document</field>
        <field name="arch" type="xml">
            <list string="Document Compliance" editable="bottom" create="0">
                <field name="employee_id" readonly="1"/>
                <field name="department_id" readonly="1" optional="show"/>
                <field name="document_type_id" readonly="1"/>
                <field name="expiry_required" column_invisible="1"/>
                <field name="mandatory" optional="hide"/>
                <field name="reference" optional="hide"/>
                <field name="document_file" filename="document_filename" widget="nx_file_dropzone"/>
                <field name="document_filename" column_invisible="1"/>
                <field name="expiry_date" invisible="not expiry_required" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'complete'"
                       decoration-warning="state == 'expiring'"
                       decoration-danger="state in ('missing','expired')"/>
            </list>
        </field>
    </record>

    <record id="action_hr_employee_document" model="ir.actions.act_window">
        <field name="name">Document Compliance</field>
        <field name="res_model">hr.employee.document</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_hr_employee_document_compliance_list"/>
        <field name="search_view_id" ref="view_hr_employee_document_search"/>
        <field name="context">{'search_default_mandatory': 1, 'search_default_group_status': 1}</field>
    </record>
</odoo>
