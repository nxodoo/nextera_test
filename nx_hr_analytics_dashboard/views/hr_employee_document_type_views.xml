<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Document Type list ────────────────────────────────────────────── -->
    <record id="view_hr_employee_document_type_list" model="ir.ui.view">
        <field name="name">hr.employee.document.type.list</field>
        <field name="model">hr.employee.document.type</field>
        <field name="arch" type="xml">
            <list string="Document Types">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code" optional="hide"/>
                <field name="applies_to_gender"/>
                <field name="department_ids" widget="many2many_tags" optional="show"/>
                <field name="job_ids" widget="many2many_tags" optional="hide"/>
                <field name="mandatory"/>
                <field name="expiry_required"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ── Document Type form ────────────────────────────────────────────── -->
    <record id="view_hr_employee_document_type_form" model="ir.ui.view">
        <field name="name">hr.employee.document.type.form</field>
        <field name="model">hr.employee.document.type</field>
        <field name="arch" type="xml">
            <form string="Document Type">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. National ID"/></h1>
                    </div>
                    <group>
                        <group string="Definition">
                            <field name="code"/>
                            <field name="mandatory"/>
                            <field name="expiry_required"/>
                            <field name="expiry_alert_days" invisible="not expiry_required"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Applicability Rules">
                            <field name="applies_to_gender"/>
                            <field name="department_ids" widget="many2many_tags"
                                   placeholder="All departments"/>
                            <field name="job_ids" widget="many2many_tags"
                                   placeholder="All job positions"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" placeholder="Notes for HR..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_employee_document_type" model="ir.actions.act_window">
        <field name="name">Document Types</field>
        <field name="res_model">hr.employee.document.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first document type</p>
            <p>Define the documents HR requires from employees. Applicability rules
               let a document apply only to certain genders, departments or jobs.</p>
        </field>
    </record>

    <menuitem id="menu_hr_employee_document_type"
              name="Document Types"
              parent="hr.menu_human_resources_configuration"
              action="action_hr_employee_document_type"
              sequence="90"/>

    <!-- One-click backfill: generate the required-document checklist for all
         existing employees (new employees are handled automatically). -->
    <record id="action_generate_all_employee_documents" model="ir.actions.server">
        <field name="name">Generate Employee Documents</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="state">code</field>
        <field name="code">
records = env['hr.employee'].with_context(active_test=False).search([])
records._sync_required_documents()
action = {
    'type': 'ir.actions.client',
    'tag': 'display_notification',
    'params': {
        'title': 'Employee Documents',
        'message': '%s employees processed.' % len(records),
        'type': 'success',
        'sticky': False,
    },
}
        </field>
    </record>

    <menuitem id="menu_generate_all_employee_documents"
              name="Generate Employee Documents"
              parent="hr.menu_human_resources_configuration"
              action="action_generate_all_employee_documents"
              sequence="91"/>
</odoo>
