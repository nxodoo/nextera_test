<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ Test Calculation Wizard ============ -->
    <record id="view_nx_egypt_payroll_tax_test_form" model="ir.ui.view">
        <field name="name">nx.egypt.payroll.tax.test.form</field>
        <field name="model">nx.egypt.payroll.tax.test</field>
        <field name="arch" type="xml">
            <form string="Test Calculation">
                <group>
                    <group string="Inputs">
                        <field name="monthly_gross"/>
                        <field name="annual_equivalent" readonly="1"/>
                        <field name="personal_exemption" readonly="1"/>
                        <field name="other_deductions"/>
                        <field name="additional_taxable"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <group string="Results">
                        <field name="annual_gross" readonly="1"/>
                        <field name="exemption_applied" readonly="1"/>
                        <field name="other_deductions_annual" readonly="1"/>
                        <field name="additional_amount" readonly="1"/>
                        <field name="annual_taxable" readonly="1"/>
                        <field name="matched_category_id" readonly="1"/>
                        <field name="total_annual_tax" readonly="1"/>
                        <field name="monthly_tax" readonly="1"
                               class="oe_inline" style="font-weight:bold;"/>
                        <field name="net_salary" readonly="1"/>
                    </group>
                </group>
                <div class="alert alert-info" role="alert">
                    For <b>testing only</b>. Enter a monthly gross salary to see the
                    matching net-income category and the resulting tax. On a Payslip,
                    the <b>Income Tax (EGY_TAX)</b> rule computes each employee's tax
                    automatically.
                </div>
                <footer>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_nx_egypt_payroll_tax_test" model="ir.actions.act_window">
        <field name="name">Test Calculation</field>
        <field name="res_model">nx.egypt.payroll.tax.test</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ===================== List ===================== -->
    <record id="view_nx_egypt_payroll_tax_list" model="ir.ui.view">
        <field name="name">nx.egypt.payroll.tax.list</field>
        <field name="model">nx.egypt.payroll.tax</field>
        <field name="arch" type="xml">
            <list string="Egypt Payroll Tax Categories" js_class="egypt_tax_list"
                  decoration-success="state == 'active'"
                  decoration-muted="state == 'inactive'">
                <field name="name"/>
                <field name="net_income_from"/>
                <field name="net_income_to"/>
                <field name="total_exemption_limit"/>
                <field name="effective_date"/>
                <field name="created_by_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-info="state == 'draft'"
                       decoration-muted="state == 'inactive'"/>
            </list>
        </field>
    </record>

    <!-- ===================== Form ===================== -->
    <record id="view_nx_egypt_payroll_tax_form" model="ir.ui.view">
        <field name="name">nx.egypt.payroll.tax.form</field>
        <field name="model">nx.egypt.payroll.tax</field>
        <field name="arch" type="xml">
            <form string="Egypt Payroll Tax">
                <header>
                    <button name="action_activate" type="object" string="Activate"
                            class="oe_highlight" invisible="state == 'active'"
                            help="Move this version to Active."/>
                    <button name="action_set_draft" type="object" string="Set to Draft"
                            invisible="state != 'active'"/>
                    <button name="action_create_new_version" type="object"
                            string="Create New Version" class="btn-secondary"
                            invisible="state != 'active'"
                            help="Close this version and create a new Draft version."/>
                    <button name="action_view_versions" type="object" string="Versions"
                            class="btn-secondary"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,inactive"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Category name"/></h1>
                    </div>
                    <group>
                        <group string="Net-Income Range">
                            <field name="net_income_from"/>
                            <field name="net_income_to"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="total_exemption_limit"/>
                            <field name="effective_date"/>
                            <field name="end_date"/>
                            <field name="created_by_id"/>
                            <field name="created_on"/>
                        </group>
                    </group>
                    <notebook>
                        <!-- ============ Tax Brackets ============ -->
                        <page string="Tax Brackets" name="brackets">
                            <h3>Tax Brackets (Annual)</h3>
                            <field name="bracket_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="rate"/>
                                    <field name="amount_from"/>
                                    <field name="amount_to"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                            <p class="text-muted">
                                This category applies to employees whose annual net income is
                                within the <b>Net-Income Range</b> above. The <b>From</b>/<b>To</b>
                                bounds drive the progressive <b>Rate</b> computation over this
                                category's brackets.
                            </p>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ===================== Action ===================== -->
    <record id="action_nx_egypt_payroll_tax" model="ir.actions.act_window">
        <field name="name">Egypt Payroll Tax</field>
        <field name="res_model">nx.egypt.payroll.tax</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first Egypt Payroll Tax version</p>
            <p>Define the Egyptian income-tax brackets, manage versions and test the monthly tax calculation.</p>
        </field>
    </record>

    <!-- ===================== Menu ===================== -->
    <menuitem id="menu_nx_egypt_payroll_tax"
              name="Egypt Payroll Tax"
              parent="hr_work_entry_contract_enterprise.menu_hr_payroll_configuration"
              action="action_nx_egypt_payroll_tax"
              sequence="90"/>

</odoo>
