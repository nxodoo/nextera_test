<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_training_attendance_search" model="ir.ui.view">
            <field name="name">training.attendance.search</field>
            <field name="model">training.attendance</field>
            <field name="arch" type="xml">
                <search>
                    <field name="training_assignment_id"/>
                    <field name="facilitator_id"/>
                    <field name="attendance_date"/>
                    <field name="company_id"/>
                </search>
            </field>
        </record>

        <record id="view_training_attendance_list" model="ir.ui.view">
            <field name="name">training.attendance.list</field>
            <field name="model">training.attendance</field>
            <field name="arch" type="xml">
                <list default_order="attendance_date desc, id desc">
                    <field name="training_assignment_id"/>
                    <field name="attendance_date"/>
                    <field name="submitted_by"/>
                    <field name="duration"/>
                    <field name="facilitator_id"/>
                    <field name="present_count"/>
                    <field name="absent_count"/>
                    <field name="company_id" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="view_training_attendance_form" model="ir.ui.view">
            <field name="name">training.attendance.form</field>
            <field name="model">training.attendance</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="training_assignment_id"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="training_on"/>
                                <field name="attendance_date"/>
                                <field name="duration"/>
                                <field name="facilitator_id"/>
                            </group>
                            <group>
                                <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                                <field name="present_count" readonly="1"/>
                                <field name="absent_count" readonly="1"/>
                                <field name="submitted_by"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Trainees">
                                <field name="attendee_line_ids" nolabel="1">
                                    <list editable="bottom" create="0" delete="0">
                                        <field name="employee_id" readonly="1"/>
                                        <button name="action_view_employee"
                                                string="View"
                                                type="object"
                                                class="btn-link"
                                                icon="fa-external-link"/>
                                        <field name="department_id" readonly="1"/>
                                        <field name="is_present"/>
                                        <field name="note"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_training_attendance" model="ir.actions.act_window">
            <field name="name">Training Attendance</field>
            <field name="res_model">training.attendance</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_training_attendance_search"/>
        </record>

        <menuitem id="menu_training_attendance"
                  name="Training Attendance"
                  parent="menu_training_assessment_root"
                  action="action_training_attendance"
                  sequence="30"/>
    </data>
</odoo>
