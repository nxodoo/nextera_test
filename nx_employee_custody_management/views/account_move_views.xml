<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_custody" model="ir.ui.view">
        <field name="name">account.move.form.custody</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_register_payment']" position="after">
                <button name="action_open_custody_payment_wizard"
                        type="object"
                        string="Pay via Custody"
                        class="oe_highlight"
                        invisible="move_type != 'in_invoice' or state != 'posted'"/>
            </xpath>
        </field>
    </record>

</odoo>