<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_account_journal_form_inherit_custody" model="ir.ui.view">
        <field name="name">account.journal.form.inherit.custody</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_account_id']" position="after">
                <field name="is_custody"/>
            </xpath>
        </field>
    </record>

</odoo>
