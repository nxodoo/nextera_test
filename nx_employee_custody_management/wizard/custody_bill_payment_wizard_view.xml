<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Wizard Form View -->
    <record id="view_custody_bill_payment_wizard_form" model="ir.ui.view">
        <field name="name">custody.bill.payment.wizard.form</field>
        <field name="model">custody.bill.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Pay via Custody" version="7.0">
                <group>
                    <group>
                        <field name="bill_id" invisible="1"/>
                        <field name="journal_id" domain="[('id', 'in', journal_ids)]" options="{'no_create': True}"/>
                        <field name="employee_id" domain="[('id', 'in', employee_ids)]" options="{'no_create': True}"/>
                        <field name="custody_account_id"/>
                        <field name="payment_method_line_id"/>
                        <field name="payment_date"/>
                        <field name="memo"/>
                    </group>
                    <group>
                        <field name="balance" readonly="1"/>
                        <field name="remaining_amount" readonly="1"/>
                        <field name="amount"/>
                    </group>
                </group>

                <footer>
                    <button string="Confirm"
                            type="object"
                            name="action_create_payment"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>


</odoo>
