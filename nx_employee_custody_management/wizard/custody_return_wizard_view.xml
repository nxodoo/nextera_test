<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_custody_return_wizard" model="ir.ui.view">
        <field name="name">custody.return.wizard.form</field>
        <field name="model">custody.return.wizard</field>
        <field name="arch" type="xml">
            <form string="Return Custody">
                <group>
                    <group>
                        <field name="custody_id" invisible="1"/>
                        <field name="balance"/>
                        <field name="amount"/>
                    </group>
                    <group>
                        <field name="journal_id" domain="[('id', 'not in', journal_ids),('type','in',['cash', 'bank'])]" options="{'no_create': True}"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm_return"
                            string="Confirm"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>